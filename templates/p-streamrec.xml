<Container version="2">
  <Name>P-StreamRec</Name>
  <Repository>ghcr.io/raccommode/p-streamrec:latest</Repository>
  <Registry>https://github.com/raccommode/P-StreamRec/pkgs/container/p-streamrec</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <Overview>P-StreamRec is a self-hosted recorder for Chaturbate, CAM4, and m3u8/HLS live streams, with a web interface for discovery, following, live watch, recordings, password protection, optional account login, recording segmentation, and automatic MP4 conversion.</Overview>
  <Support>https://github.com/raccommode/P-StreamRec/issues</Support>
  <Project>https://github.com/raccommode/P-StreamRec</Project>
  <ReadMe>https://raw.githubusercontent.com/raccommode/P-StreamRec/main/README.md</ReadMe>
  <TemplateURL>https://raw.githubusercontent.com/raccommode/Raccommode-Unraid-Community-Apps/main/templates/p-streamrec.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/raccommode/P-StreamRec/main/p-streamrec-store-p-streamrec/icon.svg</Icon>
  <Category>MediaApp:Video Tools:Utilities</Category>
  <License>Non-Commercial Open Source License</License>
  <Screenshot>https://raw.githubusercontent.com/raccommode/P-StreamRec/main/discover.png</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/raccommode/P-StreamRec/main/following.png</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/raccommode/P-StreamRec/main/recordings.png</Screenshot>
  <Config Name="Web UI Port" Target="8080" Default="7399" Mode="tcp" Description="Web interface port. Host port defaults to 7399; container port: 8080." Type="Port" Display="always" Required="true" Mask="false">7399</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/p-streamrec" Mode="rw" Description="Stores the database, sessions, thumbnails, cookies, original TS recordings, and converted MP4 files." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/p-streamrec</Config>
</Container>
